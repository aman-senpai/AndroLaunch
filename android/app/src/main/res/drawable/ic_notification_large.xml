<?xml version="1.0" encoding="utf-8"?>
<!--
    Large icon for the foreground notification: a full-bleed brand-green disc with
    a white link glyph, composed for the circular crop that Android applies to
    notification large icons. The glyph is the same "link" mark as the small icon,
    scaled into the 108 unit viewport and centred on the disc.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="64dp"
    android:height="64dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Brand disc (2 units of padding keeps anti-aliased edges clean) -->
    <path
        android:fillColor="@color/al_brand"
        android:pathData="M54,2a52,52 0 1,1 0,104a52,52 0 1,1 0,-104z" />

