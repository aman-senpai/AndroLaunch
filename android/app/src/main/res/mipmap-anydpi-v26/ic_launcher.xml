<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive launcher icon for AndroLaunch Comp.

    Background: neutral plate (platform mask supplies the shape).
    Foreground: green screen + Android head (the established product mark).
    Monochrome: head-only layer for Android 13+ themed icons.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/al_icon_plate" />
    <foreground android:drawable="@drawable/al_ic_launcher_fg" />
    <monochrome android:drawable="@drawable/al_ic_launcher_mono" />
</adaptive-icon>
